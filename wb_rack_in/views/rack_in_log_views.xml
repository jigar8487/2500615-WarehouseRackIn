<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- List View for rack.in.log.line -->
    <record id="view_rack_in_log_line_tree" model="ir.ui.view">
        <field name="name">rack.in.log.line.list</field>
        <field name="model">rack.in.log.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="product_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="staging_qty"/>
                <field name="put_qty"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_rack_in_log_form" model="ir.ui.view">
        <field name="name">rack.in.log.form</field>
        <field name="model">rack.in.log</field>
        <field name="arch" type="xml">
            <form string="RackIn Entry">
                <header name="rack_in_log_header">
                    <button name="action_rack_in" type="object" string="RackIn" class="oe_highlight" invisible="rack_quant_id != False"/>
                    <field name="status" readonly="1" widget="statusbar"/>
                </header>
                <sheet>
                    <group name="rack_in_log_info">
                        <group name="rack_details" string="Rack Details">
                            <field name="source_location_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="rack_location_id" options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="performed_by_display" readonly="1"/>
                            <field name="performed_by_user" readonly="1" invisible="1"/>
                            <field name="performed_by" readonly="1" invisible="1"/>
                        </group>
                        <group name="operation_info" string="Operation Info">
                            <field name="date_time" readonly="1"/>
                            <field name="operation_source"/>
                            <field name="rack_quant_id"/>
                        </group>
                    </group>

                    <notebook name="rack_in_log_notebook">
                        <page name="rack_in_products" string="RackIn Products">
                            <field name="rack_in_log_line_ids" nolabel="1" context="{'tree_view_ref': 'wb_rack_in.view_rack_in_log_line_tree'}">
                                <list editable="bottom">
                                    <field name="product_id" options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="staging_qty"/>
                                    <field name="put_qty"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <!-- Standard chatter for messages, activities, followers -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_rack_in_log_tree" model="ir.ui.view">
        <field name="name">rack.in.log.list</field>
        <field name="model">rack.in.log</field>
        <field name="arch" type="xml">
            <list string="RackIn Logs">
                <field name="date_time"/>
                <field name="rack_location_id"/>
                <field name="performed_by_display"/>
                <field name="operation_source" widget="badge" column_invisible="1"/>
                <field name="status" widget="badge" column_invisible="1" />
                <field name="status_html"/>
                <field name="source_html"/>
            </list>
        </field>
    </record>


    <record id="view_rack_in_log_search" model="ir.ui.view">
        <field name="name">rack.in.log.search</field>
        <field name="model">rack.in.log</field>
        <field name="arch" type="xml">
            <search string="RackIn Logs Search">
                <field name="rack_in_log_line_ids" string="Product"/>
            </search>
        </field>
    </record>


    <!-- Action -->
    <record id="action_rack_in_log" model="ir.actions.act_window">
        <field name="name">RackIn Operation</field>
        <field name="res_model">rack.in.log</field>
        <field name="view_mode">list,form,search</field>
        <field name="help" type="html">
            <p>RackIn operations log.</p>
        </field>
    </record>

    <menuitem id="menu_rack_in_root" name="Warehouse RackIn"/>

    <menuitem id="menu_rack_in_log" name="RackIn Operation"
              parent="menu_rack_in_root"
              action="action_rack_in_log"
              sequence="10"/>
</odoo>
